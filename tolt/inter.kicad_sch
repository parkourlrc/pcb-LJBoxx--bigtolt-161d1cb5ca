	(text_box "input voltage will be up to 150v \n240k and 5.1k looks good and can sense up to 158.6v \n"
		(exclude_from_sim no)
		(at 183.642 19.05 0)
		(size 18.796 15.875)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
